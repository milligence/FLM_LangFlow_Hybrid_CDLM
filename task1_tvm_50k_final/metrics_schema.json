{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task1 TVM final metric event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_name",
    "line",
    "event",
    "global_step",
    "contract_sha256",
    "code_manifest_sha256",
    "dimensions",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_name": {
      "type": "string"
    },
    "line": {
      "enum": [
        "F",
        "P",
        "BASELINE"
      ]
    },
    "event": {
      "enum": [
        "train",
        "local_validation",
        "map_validation",
        "gradient_audit",
        "sc_gate",
        "generation",
        "precheck",
        "health_review"
      ]
    },
    "global_step": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50000
    },
    "timestamp_utc": {
      "type": "string"
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "code_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weights": {
          "enum": [
            "online",
            "target_ema",
            "eval_ema",
            "baseline",
            "not_applicable"
          ]
        },
        "t_bin": {
          "type": [
            "string",
            "null"
          ]
        },
        "gap_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "chi_bin": {
          "type": [
            "string",
            "null"
          ]
        },
        "grid": {
          "type": [
            "string",
            "null"
          ]
        },
        "interval_index": {
          "type": [
            "integer",
            "null"
          ]
        },
        "parameter_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "block": {
          "type": [
            "string",
            "null"
          ]
        },
        "teacher_K_old": {
          "type": [
            "integer",
            "null"
          ]
        },
        "teacher_K_new": {
          "type": [
            "integer",
            "null"
          ]
        },
        "teacher_checkpoint_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference_step": {
          "type": [
            "integer",
            "null"
          ]
        },
        "probe_manifest_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkpoint_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "metric_definition_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "generation_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "terminal": {
          "type": [
            "number",
            "null"
          ]
        },
        "jvp_backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "microbatch": {
          "type": [
            "integer",
            "null"
          ]
        },
        "map_microbatch": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sc_logical_group_size": {
          "type": [
            "integer",
            "null"
          ]
        },
        "gate_accepted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "review_severity": {
          "enum": [
            "none",
            "warning",
            "owner_review",
            "hard_stop",
            null
          ]
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heldout_local_loss": {
          "type": [
            "number",
            "null"
          ],
          "description": "Primary F probability-MSE or P CE; immutable bank and node weights.",
          "x-group": "local"
        },
        "local_ce": {
          "type": [
            "number",
            "null"
          ],
          "description": "Clean-token cross entropy, vocab natural logs.",
          "x-group": "local"
        },
        "local_probability_mse": {
          "type": [
            "number",
            "null"
          ],
          "description": "0.5 sum_vocab((p-onehot)^2), then mean tokens.",
          "x-group": "local"
        },
        "local_target_probability": {
          "type": [
            "number",
            "null"
          ],
          "description": "Mean p(y).",
          "x-group": "local"
        },
        "local_top1_accuracy": {
          "type": [
            "number",
            "null"
          ],
          "description": "Argmax(p)==y.",
          "x-group": "local"
        },
        "local_posterior_entropy_nats": {
          "type": [
            "number",
            "null"
          ],
          "description": "Mean per-position categorical posterior entropy.",
          "x-group": "local"
        },
        "local_velocity_mse": {
          "type": [
            "number",
            "null"
          ],
          "description": "Unweighted sample velocity MSE, sum vocab then mean; distinguish from anchor.",
          "x-group": "local"
        },
        "local_pred_velocity_norm": {
          "type": [
            "number",
            "null"
          ],
          "description": "Mean per-token L2 norm.",
          "x-group": "local"
        },
        "local_target_velocity_norm": {
          "type": [
            "number",
            "null"
          ],
          "description": "Mean per-token L2 norm.",
          "x-group": "local"
        },
        "local_velocity_cosine": {
          "type": [
            "number",
            "null"
          ],
          "description": "Per-token cosine averaged.",
          "x-group": "local"
        },
        "local_loss_standard_error": {
          "type": [
            "number",
            "null"
          ],
          "description": "Sequence-clustered standard error.",
          "x-group": "local"
        },
        "local_reference_relative_change": {
          "type": [
            "number",
            "null"
          ],
          "description": "Relative change on identical fixed bank; reference step in dimensions.",
          "x-group": "local"
        },
        "map_loss_weighted": {
          "type": [
            "number",
            "null"
          ],
          "description": "Training weighted objective divided by 96.",
          "x-group": "map"
        },
        "map_loss_unweighted": {
          "type": [
            "number",
            "null"
          ],
          "description": "Current pairs with all class weights=1; diagnostic.",
          "x-group": "map"
        },
        "map_residual_l1": {
          "type": [
            "number",
            "null"
          ],
          "description": "Mean per-token sum of absolute Q-pT or Q_F-pT.",
          "x-group": "map"
        },
        "map_residual_l2_squared": {
          "type": [
            "number",
            "null"
          ],
          "description": "Mean per-token sum of squared residual, no vocab mean.",
          "x-group": "map"
        },
        "map_residual_rms_per_coordinate": {
          "type": [
            "number",
            "null"
          ],
          "description": "Diagnostic only: sqrt(mean over B,L,V).",
          "x-group": "map"
        },
        "terminal_velocity_residual_l2_squared": {
          "type": [
            "number",
            "null"
          ],
          "description": "Mean token sum raw residual/(1-s) squared.",
          "x-group": "map"
        },
        "terminal_tangent_norm": {
          "type": [
            "number",
            "null"
          ],
          "description": "Mean per-token norm of d_s Y.",
          "x-group": "map"
        },
        "terminal_teacher_velocity_norm": {
          "type": [
            "number",
            "null"
          ],
          "description": "Mean per-token teacher velocity norm.",
          "x-group": "map"
        },
        "jvp_logit_tangent_norm": {
          "type": [
            "number",
            "null"
          ],
          "description": "Mean norm d_eta logits.",
          "x-group": "map"
        },
        "jvp_output_tangent_norm": {
          "type": [
            "number",
            "null"
          ],
          "description": "Mean norm d_eta A/R.",
          "x-group": "map"
        },
        "negative_mass": {
          "type": [
            "number",
            "null"
          ],
          "description": "P: mean sum ReLU(-Q); F: null.",
          "x-group": "map"
        },
        "negative_mass_squared": {
          "type": [
            "number",
            "null"
          ],
          "description": "P regularizer before its coefficient; F: null.",
          "x-group": "map"
        },
        "calibrated_kl": {
          "type": [
            "number",
            "null"
          ],
          "description": "P KL(qT||qS), always unweighted diagnostic.",
          "x-group": "map"
        },
        "calibrated_ce": {
          "type": [
            "number",
            "null"
          ],
          "description": "P CE(qT,qS), target entropy may move.",
          "x-group": "map"
        },
        "calibration_student_l1_change": {
          "type": [
            "number",
            "null"
          ],
          "description": "sum |qS-Q| per token.",
          "x-group": "map"
        },
        "calibration_teacher_l1_change": {
          "type": [
            "number",
            "null"
          ],
          "description": "sum |qT-pT| per token.",
          "x-group": "map"
        },
        "raw_Q_sum_max_error": {
          "type": [
            "number",
            "null"
          ],
          "description": "max |sum_vocab Q-1|.",
          "x-group": "map"
        },
        "finite_output_entropy": {
          "type": [
            "number",
            "null"
          ],
          "description": "P R entropy; F p entropy only, never entropy of signed A.",
          "x-group": "map"
        },
        "target_posterior_entropy": {
          "type": [
            "number",
            "null"
          ],
          "description": "Entropy of pT.",
          "x-group": "map"
        },
        "F_A_negative_mass": {
          "type": [
            "number",
            "null"
          ],
          "description": "F signed A diagnostic, not penalized.",
          "x-group": "map"
        },
        "F_B_l2": {
          "type": [
            "number",
            "null"
          ],
          "description": "Mean per-token L2 norm of centered correction.",
          "x-group": "map"
        },
        "F_eta_B_l2": {
          "type": [
            "number",
            "null"
          ],
          "description": "Mean norm eta*B.",
          "x-group": "map"
        },
        "F_eta2_B_l2": {
          "type": [
            "number",
            "null"
          ],
          "description": "Mean endpoint correction eta^2*B.",
          "x-group": "map"
        },
        "endpoint_coupled_shift_noise_normalized": {
          "type": [
            "number",
            "null"
          ],
          "description": "RMS over token L2 norms of (Y-x_s_pair)/(1-s), diagnostic not true map error.",
          "x-group": "map"
        },
        "chi_mean": {
          "type": [
            "number",
            "null"
          ],
          "description": "mean eta/(1-s).",
          "x-group": "map"
        },
        "chi_max": {
          "type": [
            "number",
            "null"
          ],
          "description": "max eta/(1-s).",
          "x-group": "map"
        },
        "teacher_offpath_functional_shift": {
          "type": [
            "number",
            "null"
          ],
          "description": "KL or MSE between teacher(Y,s) and teacher(x_s_pair,s), not target correctness.",
          "x-group": "map"
        },
        "fixed_endpoint_teacher_drift": {
          "type": [
            "number",
            "null"
          ],
          "description": "Field drift on immutable endpoint probe, monitor only.",
          "x-group": "map"
        },
        "frozen_teacher_probe_residual": {
          "type": [
            "number",
            "null"
          ],
          "description": "Residual using a versioned frozen diagnostic teacher; never a training target.",
          "x-group": "map"
        },
        "map_residual_standard_error": {
          "type": [
            "number",
            "null"
          ],
          "description": "Sequence-clustered standard error.",
          "x-group": "map"
        },
        "local_grad_norm": {
          "type": [
            "number",
            "null"
          ],
          "description": "Norm on named shared parameter set, before total clipping.",
          "x-group": "optimization"
        },
        "map_grad_norm_raw": {
          "type": [
            "number",
            "null"
          ],
          "description": "All weights one, no lambda, shared parameters.",
          "x-group": "optimization"
        },
        "map_grad_norm_class_weighted": {
          "type": [
            "number",
            "null"
          ],
          "description": "Class-weighted, no lambda, shared parameters.",
          "x-group": "optimization"
        },
        "closure_grad_norm": {
          "type": [
            "number",
            "null"
          ],
          "description": "No lambda, shared parameters.",
          "x-group": "optimization"
        },
        "grad_cosine_local_map": {
          "type": [
            "number",
            "null"
          ],
          "description": "Cosine(local gradient, class-weighted map gradient).",
          "x-group": "optimization"
        },
        "grad_cosine_local_closure": {
          "type": [
            "number",
            "null"
          ],
          "description": "Cosine(local gradient, closure gradient).",
          "x-group": "optimization"
        },
        "weighted_grad_ratio_map": {
          "type": [
            "number",
            "null"
          ],
          "description": "lambda_m * norm(g_map_weighted)/norm(g_local).",
          "x-group": "optimization"
        },
        "weighted_grad_ratio_closure": {
          "type": [
            "number",
            "null"
          ],
          "description": "lambda_c * norm(g_close)/norm(g_local).",
          "x-group": "optimization"
        },
        "rho_map_target": {
          "type": [
            "number",
            "null"
          ],
          "description": "Schedule budget, not guaranteed achieved ratio.",
          "x-group": "optimization"
        },
        "rho_closure_target": {
          "type": [
            "number",
            "null"
          ],
          "description": "Schedule times accepted-refinement mass.",
          "x-group": "optimization"
        },
        "lambda_map": {
          "type": [
            "number",
            "null"
          ],
          "description": "Detached calibrated scalar.",
          "x-group": "optimization"
        },
        "lambda_closure": {
          "type": [
            "number",
            "null"
          ],
          "description": "Detached calibrated scalar.",
          "x-group": "optimization"
        },
        "C_map": {
          "type": [
            "number",
            "null"
          ],
          "description": "Detached calibration scale.",
          "x-group": "optimization"
        },
        "C_closure": {
          "type": [
            "number",
            "null"
          ],
          "description": "Detached calibration scale.",
          "x-group": "optimization"
        },
        "global_grad_norm_preclip": {
          "type": [
            "number",
            "null"
          ],
          "description": "All trainable params before clip.",
          "x-group": "optimization"
        },
        "global_grad_norm_postclip": {
          "type": [
            "number",
            "null"
          ],
          "description": "After global clipping.",
          "x-group": "optimization"
        },
        "clip_fraction_window": {
          "type": [
            "number",
            "null"
          ],
          "description": "Fraction clipped in last 250 updates.",
          "x-group": "optimization"
        },
        "parameter_norm": {
          "type": [
            "number",
            "null"
          ],
          "description": "L2 norm for dimension parameter_group/block.",
          "x-group": "optimization"
        },
        "update_norm": {
          "type": [
            "number",
            "null"
          ],
          "description": "Actual optimizer parameter delta norm.",
          "x-group": "optimization"
        },
        "update_rms": {
          "type": [
            "number",
            "null"
          ],
          "description": "Actual delta RMS, meaningful for zero-init weights.",
          "x-group": "optimization"
        },
        "update_weight_ratio": {
          "type": [
            "number",
            "null"
          ],
          "description": "||delta||/max(||theta_before||,1e-6*sqrt(numel)).",
          "x-group": "optimization"
        },
        "adam_update_discrepancy_proxy": {
          "type": [
            "number",
            "null"
          ],
          "description": "Virtual joint vs local-only Adam data update, same moments; diagnostic without optimizer mutation.",
          "x-group": "optimization"
        },
        "adam_update_cosine_proxy": {
          "type": [
            "number",
            "null"
          ],
          "description": "Cosine of virtual joint and local-only data updates.",
          "x-group": "optimization"
        },
        "lr_legacy": {
          "type": [
            "number",
            "null"
          ],
          "description": "Actual step LR.",
          "x-group": "optimization"
        },
        "lr_finite_G": {
          "type": [
            "number",
            "null"
          ],
          "description": "Actual step LR.",
          "x-group": "optimization"
        },
        "lr_finite_B": {
          "type": [
            "number",
            "null"
          ],
          "description": "F actual correction LR; P null.",
          "x-group": "optimization"
        },
        "finite_lr_bootstrap_gate": {
          "type": [
            "number",
            "null"
          ],
          "description": "rho_map/0.30 capped at 1.",
          "x-group": "optimization"
        },
        "hard_class_weight": {
          "type": [
            "number",
            "null"
          ],
          "description": "Scheduled class coefficient.",
          "x-group": "optimization"
        },
        "nonfinite_count": {
          "type": [
            "number",
            "null"
          ],
          "description": "Count observed before attempted update.",
          "x-group": "optimization"
        },
        "activation_norm": {
          "type": [
            "number",
            "null"
          ],
          "description": "Layer-group diagnostic.",
          "x-group": "optimization"
        },
        "adaln_modulation_norm": {
          "type": [
            "number",
            "null"
          ],
          "description": "Layer-group diagnostic.",
          "x-group": "optimization"
        },
        "ema_online_target_kl": {
          "type": [
            "number",
            "null"
          ],
          "description": "Same cold query, target vs online KL.",
          "x-group": "optimization"
        },
        "ema_online_target_mse": {
          "type": [
            "number",
            "null"
          ],
          "description": "Same cold query posterior MSE.",
          "x-group": "optimization"
        },
        "ema_target_local_loss_lag": {
          "type": [
            "number",
            "null"
          ],
          "description": "target local loss minus online on same bank.",
          "x-group": "optimization"
        },
        "ema_eval_local_loss_lag": {
          "type": [
            "number",
            "null"
          ],
          "description": "eval EMA minus online on same bank.",
          "x-group": "optimization"
        },
        "ema_target_decay_actual": {
          "type": [
            "number",
            "null"
          ],
          "description": "Warm-started value used.",
          "x-group": "optimization"
        },
        "ema_eval_decay_actual": {
          "type": [
            "number",
            "null"
          ],
          "description": "Warm-started value used.",
          "x-group": "optimization"
        },
        "local_SC_fraction": {
          "type": [
            "number",
            "null"
          ],
