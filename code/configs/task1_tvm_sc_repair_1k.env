# No-composition SC-repair through step 1000. The LR scheduler intentionally
# retains max_steps=2000; the release wrapper installs a planned stop at 1000.
GLOBAL_BATCH_SIZE=128
MICRO_BATCH_SIZE=32
ACCUMULATE_GRAD_BATCHES=4
HARDWARE_PROFILE=5090
TRAINER_DEVICES=1
STRATEGY_CONFIG=single_device
MODEL_CONFIG=small_128
DATA_CONFIG=openwebtext_327m_packed
TRAINING_TIME_SAMPLING=tvm_normalized_gap_curriculum
RUN_DIR=
MAX_STEPS=2000
EXPERIMENT_RUN_ID=task1-tvm-sc-repair-no-comp-1k
LEARNING_RATE=5e-5
OPTIM_BETA1=0.9
OPTIM_BETA2=0.95
OPTIM_EPS=1e-8
OPTIM_WEIGHT_DECAY=0
EMA_DECAY=0.9999
LR_SCHEDULER_CONFIG=cosine_decay_warmup
WARMUP_STEPS=250
TOKEN_BIAS_WARMUP_STEPS=0
TVM_TRAINING_BUDGET_STEPS=2000
TVM_CURRICULUM_FRACTION=0.10
TVM_ENDPOINT_TEACHER_SC_MODE=zero_sc
TVM_ENDPOINT_WEIGHT=0.0
TEACHER_PATH=
TVM_STUDENT_INIT_PATH=
TVM_SC_PAIR_BANK_PATH=
TVM_SC_GATE_D50=0.0001
TVM_SC_STEP0_CHECKPOINT_PATH=
VALIDATION_INTERVAL_STEPS=500
LIMIT_VAL_BATCHES=8
EVAL_BATCH_SIZE=4
VALIDATE_BEFORE_TRAINING=false
THROUGHPUT_EVERY_N_STEPS=10
LOG_EVERY_N_STEPS=10
MILESTONE_STEPS=[500,1000,2000]
MILESTONE_SAVE_WEIGHTS_ONLY=false
MILESTONE_LAST_EVERY_N_STEPS=250
