# Shared from-scratch posterior-TVM training contract. Arm is selected by launcher.
GLOBAL_BATCH_SIZE=256
MICRO_BATCH_SIZE=32
ACCUMULATE_GRAD_BATCHES=8
HARDWARE_PROFILE=5090
TRAINER_DEVICES=1
STRATEGY_CONFIG=single_device
MODEL_CONFIG=small_128_posterior_tvm
DATA_CONFIG=openwebtext_327m_packed
TRAINING_TIME_SAMPLING=posterior_tvm_information_cdf

RUN_DIR=
MAX_STEPS=10000
EXPERIMENT_RUN_ID=

LEARNING_RATE=3e-4
OPTIM_BETA1=0.9
OPTIM_BETA2=0.95
OPTIM_EPS=1e-8
OPTIM_WEIGHT_DECAY=0.01
EMA_DECAY=0.999
LR_SCHEDULER_CONFIG=constant_warmup
WARMUP_STEPS=1000
TOKEN_BIAS_WARMUP_STEPS=0

VALIDATION_INTERVAL_STEPS=500
LIMIT_VAL_BATCHES=8
EVAL_BATCH_SIZE=2
VALIDATE_BEFORE_TRAINING=false
THROUGHPUT_EVERY_N_STEPS=10
LOG_EVERY_N_STEPS=10
CHECKPOINT_EVERY_N_STEPS=
MILESTONE_STEPS=[1000,2000,5000,10000]
MILESTONE_SAVE_WEIGHTS_ONLY=false
MILESTONE_LAST_EVERY_N_STEPS=250
