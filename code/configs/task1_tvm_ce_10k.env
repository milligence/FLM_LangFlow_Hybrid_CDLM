# Fixed-teacher TVM-CE 10k run on one 32 GB RTX 5090.
GLOBAL_BATCH_SIZE=128
MICRO_BATCH_SIZE=32
ACCUMULATE_GRAD_BATCHES=4
HARDWARE_PROFILE=5090
TRAINER_DEVICES=1
STRATEGY_CONFIG=single_device
MODEL_CONFIG=small_128
DATA_CONFIG=openwebtext_327m_packed
TRAINING_TIME_SAMPLING=tvm_normalized_gap_curriculum
RUN_DIR=
MAX_STEPS=10000
EXPERIMENT_RUN_ID=task1-tvm-ce-10k
LEARNING_RATE=1e-4
OPTIM_BETA1=0.9
OPTIM_BETA2=0.999
OPTIM_EPS=1e-8
OPTIM_WEIGHT_DECAY=0
EMA_DECAY=0.9999
LR_SCHEDULER_CONFIG=cosine_decay_warmup
WARMUP_STEPS=2500
TOKEN_BIAS_WARMUP_STEPS=0
TVM_TRAINING_BUDGET_STEPS=10000
TVM_CURRICULUM_FRACTION=0.10
TVM_ENDPOINT_TEACHER_SC_MODE=zero_sc
TVM_ENDPOINT_WEIGHT=0.0
TEACHER_PATH=
VALIDATION_INTERVAL_STEPS=5000
LIMIT_VAL_BATCHES=8
EVAL_BATCH_SIZE=2
VALIDATE_BEFORE_TRAINING=false
THROUGHPUT_EVERY_N_STEPS=10
LOG_EVERY_N_STEPS=10
MILESTONE_STEPS=[5000,10000]
MILESTONE_SAVE_WEIGHTS_ONLY=false
MILESTONE_LAST_EVERY_N_STEPS=1000
