# Task1 A training controls. Use unquoted KEY=value lines only.
# Per-invocation environment variables take precedence over these values.

# FrozenMSE-50k selected route: fresh training uses global batch 256.
GLOBAL_BATCH_SIZE=256

# Use "auto" for the hardware-profile default (4090: 8, H800: 64), or set
# any positive divisor of GLOBAL_BATCH_SIZE explicitly, for example 32.
MICRO_BATCH_SIZE=32
ACCUMULATE_GRAD_BATCHES=8
HARDWARE_PROFILE=h800
TRAINER_DEVICES=1
TRAINING_TIME_SAMPLING=uniform_tau

# Fill these per candidate, either here in a copied config or in the environment.
RUN_DIR=
MAX_STEPS=15000
EXPERIMENT_RUN_ID=frozen-mse-a0-15k

# Fresh-training optimization defaults. Full-state resume restores Adam state;
# only an explicit RESUME_CONSTANT_LEARNING_RATE graft changes its LR.
LEARNING_RATE=6e-4
OPTIM_BETA1=0.9
OPTIM_BETA2=0.999
OPTIM_EPS=1e-8
OPTIM_WEIGHT_DECAY=0
EMA_DECAY=0.9999

# Optimizer-step clocks. They are not automatically rescaled with batch size.
WARMUP_STEPS=2500
TOKEN_BIAS_WARMUP_STEPS=5000

# Validation uses its own batch size, independent of the training batch.
EVAL_BATCH_SIZE=2
CHECKPOINT_EVERY_N_STEPS=

# Full-state continuation fields. Leave RESUME_CONSTANT_LEARNING_RATE empty to
# preserve the checkpoint LR, or set it explicitly (for example 1.5e-4).
RESUME_CHECKPOINT_PATH=
SOURCE_LEARNING_RATE=
SOURCE_GLOBAL_STEP=
TASK1_VARIANT=A
TARGET_MAX_STEPS=
TASK1_RUN_ID=
RESUME_CONSTANT_LEARNING_RATE=
