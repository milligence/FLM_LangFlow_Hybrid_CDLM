# J0 on one RTX 4090; scientific global batch remains 256.
GLOBAL_BATCH_SIZE=256
MICRO_BATCH_SIZE=8
ACCUMULATE_GRAD_BATCHES=32
HARDWARE_PROFILE=4090
TRAINER_DEVICES=1
STRATEGY_CONFIG=single_device
MODEL_CONFIG=small_128
DATA_CONFIG=openwebtext_327m_packed
TRAINING_TIME_SAMPLING=v1_m_tau25_global256
RUN_DIR=
MAX_STEPS=500
EXPERIMENT_RUN_ID=task1-tvm-joint-j0-500
LEARNING_RATE=5e-5
OPTIM_BETA1=0.9
OPTIM_BETA2=0.95
OPTIM_EPS=1e-8
OPTIM_WEIGHT_DECAY=0
EMA_DECAY=0.9999
LR_SCHEDULER_CONFIG=cosine_decay_warmup
WARMUP_STEPS=100
TOKEN_BIAS_WARMUP_STEPS=0
TVM_TRAINING_BUDGET_STEPS=500
TVM_CURRICULUM_FRACTION=0.10
TVM_ENDPOINT_TEACHER_SC_MODE=predicted_finite_state
TVM_ENDPOINT_WEIGHT=0.0
TEACHER_PATH=
TVM_STUDENT_INIT_PATH=
TVM_SC_PAIR_BANK_PATH=
TVM_SC_GATE_D50=0.0001
TVM_SC_STEP0_CHECKPOINT_PATH=
VALIDATION_INTERVAL_STEPS=100
LIMIT_VAL_BATCHES=64
EVAL_BATCH_SIZE=4
VALIDATE_BEFORE_TRAINING=false
THROUGHPUT_EVERY_N_STEPS=10
LOG_EVERY_N_STEPS=10
MILESTONE_STEPS=[100,250,500]
MILESTONE_SAVE_WEIGHTS_ONLY=false
MILESTONE_LAST_EVERY_N_STEPS=100
