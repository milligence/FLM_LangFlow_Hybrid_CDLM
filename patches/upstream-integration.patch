+def flm_clean_data_loss(model_output, target_data, loss_type,
+                        denoiser_output):
+    """Return the per-token FLM clean-data objective.
+
+    ``model_output`` is log-probability when ``denoiser_output`` is
+    ``simplex`` and an unconstrained clean-data prediction when it is
+    ``euclidean``. The MSE reduction is the squared Euclidean norm over the
+    vocabulary, matching the clean-data regression objective in Eq. (10) of
+    the FLM paper rather than averaging away the vocabulary dimension.
+    """
+    if model_output.shape != target_data.shape:
+        raise ValueError(
+            'FLM prediction and target must have identical shapes, got '
+            f'{tuple(model_output.shape)} and {tuple(target_data.shape)}.')
+    if loss_type not in {'cross_entropy', 'mse'}:
+        raise ValueError(
+            f'Unsupported FLM loss_type={loss_type!r}; expected '
+            "'cross_entropy' or 'mse'.")
+    if denoiser_output not in {'simplex', 'euclidean'}:
+        raise ValueError(
+            f'Unsupported FLM denoiser_output={denoiser_output!r}; expected '
+            "'simplex' or 'euclidean'.")
+    if loss_type == 'cross_entropy':
+        if denoiser_output != 'simplex':
+            raise ValueError(
+                'FLM cross_entropy requires denoiser_output=simplex.')
+        return -(target_data * model_output).sum(dim=-1)
+
+    prediction = (model_output.exp()
+                  if denoiser_output == 'simplex'
+                  else model_output)
+    return (prediction - target_data).square().sum(dim=-1)
+
