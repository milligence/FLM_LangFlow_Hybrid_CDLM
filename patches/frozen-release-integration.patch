+    loc = torch.as_tensor(loc, device=gamma.device, dtype=torch.float32)
+    scale = torch.as_tensor(scale, device=gamma.device, dtype=torch.float32)
+    return entropy * torch.exp(-torch.exp(-(gamma - loc) / scale))
